<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.SatIpFreesat</RootNamespace>
    <InformationalVersion>v$([System.DateTime]::Now.ToString('yyyyMMdd-HHmm'))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- net9.0 targets Jellyfin 10.x -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.*-*" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- net10.0 targets Jellyfin 12.x -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Version>2.0.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\configpage.html" />
    <None Remove="Web\configpage.js" />
    <None Remove="Web\statuspage.html" />
    <None Remove="Web\statuspage.js" />
    <EmbeddedResource Include="Web\configpage.html" />
    <EmbeddedResource Include="Web\configpage.js" />
    <EmbeddedResource Include="Web\statuspage.html" />
    <EmbeddedResource Include="Web\statuspage.js" />
  </ItemGroup>

</Project>
